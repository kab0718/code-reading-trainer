{
  "name": "code-reading-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "A Chrome extension for practicing code reading on GitHub.",
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run validate:extension",
    "format": "prettier --write \".github/**/*.yml\" \"src/**/*.{js,css,html}\" \"scripts/**/*.mjs\" \"AGENTS.md\" \"eslint.config.mjs\" \"manifest.json\" \"package.json\" \"package-lock.json\"",
    "format:check": "prettier --check \".github/**/*.yml\" \"src/**/*.{js,css,html}\" \"scripts/**/*.mjs\" \"AGENTS.md\" \"eslint.config.mjs\" \"manifest.json\" \"package.json\" \"package-lock.json\"",
    "lint": "eslint . --max-warnings=0",
    "validate:extension": "node scripts/validate-extension.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6"
  }
}
